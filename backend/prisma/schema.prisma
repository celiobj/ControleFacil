generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INVESTIDOR
  CONSULTA
}
enum PropertyStatus {
  EM_ANALISE
  ARREMATADO
  REGULARIZACAO
  REFORMA
  PRONTO_PARA_VENDA
  VENDIDO
  CANCELADO
}
enum PropertyType {
  CASA
  APARTAMENTO
  TERRENO
  COMERCIAL
  RURAL
  OUTRO
}
enum PropertyNegotiationType {
  LEILAO_SFI
  EXERCICIO_DIREITO_PREFERENCIA
  LICITACAO_ABERTA
  VENDA_ONLINE
  COMPRA_DIRETA
}
enum ExpenseCategory {
  ITBI
  CARTORIO
  ADVOGADO
  CONDOMINIO
  IPTU
  REFORMA
  LIMPEZA
  ENERGIA
  AGUA
  FINANCIAMENTO
  TAXAS
  OUTROS
}
enum FinancialCostCategory {
  ACQUISITION
  REGULARIZATION
  POSSESSION
  RENOVATION
  OPERATIONAL
  FINANCING
  SALE
  OTHER
}
enum RenovationStatus {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
}
enum ChecklistItemStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  NAO_APLICAVEL
}
enum PartnerType {
  LEILOEIRO
  CORRETOR
  EMPREITEIRA
  COMPRADOR
}
enum AcquisitionStatus {
  PLANNED
  COMPLETED
  CANCELLED
}
enum AcquisitionPaymentMethod {
  OWN_RESOURCES
  FGTS
  FINANCING
  FGTS_AND_OWN_RESOURCES
  FINANCING_AND_OWN_RESOURCES
  FGTS_AND_FINANCING
  MIXED
  OTHER
}
enum AcquisitionSource {
  AUCTION
  DIRECT
  PREFERENCE
  ONLINE
  OTHER
}
enum PropertyDocumentType {
  REGISTRY
  AUCTION_NOTICE
  PURCHASE_CONTRACT
  TAX
  CERTIFICATE
  PHOTO
  OTHER
  EDITAL
  ANUNCIO_CAIXA
  MATRICULA
  CERTIDAO_MATRICULA
  TERMO_ARREMATACAO
  COMPROVANTE_PAGAMENTO
  COMPROVANTE_FGTS
  CONTRATO_CAIXA
  ITBI
  COMPROVANTE_ITBI
  PROTOCOLO_CARTORIO
  REGISTRO_IMOVEL
  MATRICULA_ATUALIZADA
  IPTU
  CONDOMINIO
  VISTORIA
  ORCAMENTO
  NOTA_FISCAL
  FOTO
  CONTRATO_VENDA
  OUTRO
}
enum PropertyDocumentStatus {
  PENDING
  VALID
  EXPIRED
  REJECTED
  RECEIVED
  VALIDATED
  CANCELLED
  PENDENTE
  RECEBIDO
  VALIDADO
  VENCIDO
  CANCELADO
}
enum RegularizationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  BLOQUEADA
}
enum RegularizationTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}
enum RegularizationTaskCategory {
  CAIXA
  CARTORIO
  PREFEITURA
  ITBI
  CONDOMINIO
  DOCUMENTACAO
  JURIDICO
  OUTROS
}
enum PossessionStatus {
  NOT_TAKEN
  PENDING
  TAKEN
  DISPUTED
  VACANT
}
enum OccupationStatus {
  UNKNOWN
  VACANT
  OCCUPIED
  FORMER_OWNER
  TENANT
  THIRD_PARTY
  DISPUTED
}
enum PropertyEventType {
  NOTE
  STATUS_CHANGE
  DOCUMENT
  POSSESSION
  REGULARIZATION
  EXPENSE
  SALE
  OTHER
  ANALISE
  LANCE
  ARREMATACAO
  PAGAMENTO
  FGTS
  FINANCIAMENTO
  ITBI
  CARTORIO
  REFORMA
  DOCUMENTO
  REGULARIZACAO
  POSSE
  DESPESA
  VENDA
  OUTRO
}
enum SaleScenarioStatus {
  DRAFT
  ACTIVE
  SELECTED
  ARCHIVED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(INVESTIDOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  events       PropertyEvent[]
  @@map("users")
}

model Partner {
  id        String      @id @default(uuid())
  type      PartnerType
  name      String
  document  String?     @unique @db.VarChar(18)
  email     String?
  phone     String?     @db.VarChar(30)
  company   String?     @db.VarChar(120)
  notes     String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([type, name])
  @@map("partners")
}

model Property {
  id              String         @id @default(uuid())
  code            String         @unique
  title           String
  type            PropertyType
  negotiationType PropertyNegotiationType? @map("negotiation_type")
  negotiationDeadline DateTime? @map("negotiation_deadline") @db.Date
  address         String
  number          String?
  complement      String?
  neighborhood    String
  city            String
  state           String
  zipCode         String?        @map("zip_code")
  totalArea       Decimal?       @map("total_area") @db.Decimal(12,2)
  builtArea       Decimal?       @map("built_area") @db.Decimal(12,2)
  registryNumber  String?        @map("registry_number")
  description     String?
  status          PropertyStatus @default(EM_ANALISE)
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  auction         Auction?
  expenses        Expense[]
  renovations     Renovation[]
  sale            Sale?
  checklist       PropertyChecklist?
  statusHistory   PropertyStatusHistory[]
  acquisition     Acquisition?
  documents       PropertyDocument[]
  regularization  PropertyRegularization?
  possession      PropertyPossession?
  events          PropertyEvent[]
  saleScenarios   SaleScenario[]
  @@index([city, neighborhood, status, type])
  @@map("properties")
}

model PropertyStatusHistory {
  id         String        @id @default(uuid())
  propertyId String        @map("property_id")
  fromStatus PropertyStatus? @map("from_status")
  toStatus   PropertyStatus @map("to_status")
  changedAt  DateTime      @default(now()) @map("changed_at")
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, changedAt])
  @@map("property_status_history")
}

model PropertyChecklist {
  id          String          @id @default(uuid())
  propertyId  String          @unique @map("property_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  items       ChecklistItem[]
  @@map("property_checklists")
}

model ChecklistItem {
  id           String              @id @default(uuid())
  checklistId  String              @map("checklist_id")
  phase        String              @default("ANTES DO LANCE")
  stage        String              @default("")
  task         String              @default("")
  category     String
  title        String
  description  String?
  status       ChecklistItemStatus @default(PENDENTE)
  responsible  String?
  dueDate      DateTime?           @map("due_date")
  completedAt  DateTime?           @map("completed_at")
  notes        String?
  sortOrder    Int                 @default(0) @map("sort_order")
  checklist    PropertyChecklist   @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  @@index([checklistId, category, status])
  @@map("checklist_items")
}

model Auction {
  id                String   @id @default(uuid())
  propertyId        String   @unique @map("property_id")
  auctioneer        String
  broker            String?
  portal            String?
  processNumber     String?  @map("process_number")
  appraisalValue    Decimal? @map("appraisal_value") @db.Decimal(14,2)
  minimumValue      Decimal? @map("minimum_value") @db.Decimal(14,2)
  auctionValue      Decimal  @map("auction_value") @db.Decimal(14,2)
  auctionDate       DateTime @map("auction_date")
  acquisitionDate   DateTime? @map("acquisition_date")
  notes             String?
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  @@map("auctions")
}

model Expense {
  id          String          @id @default(uuid())
  propertyId  String          @map("property_id")
  category    ExpenseCategory
  financialCategory FinancialCostCategory? @map("financial_category")
  renovationId String?         @map("renovation_id")
  description String
  amount      Decimal         @db.Decimal(14,2)
  date        DateTime
  receiptPath String?         @map("receipt_path")
  contractor  String?
  notes       String?
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  renovation  Renovation?     @relation(fields: [renovationId], references: [id], onDelete: SetNull)
  @@index([propertyId, category, date])
  @@index([renovationId, date])
  @@map("expenses")
}

model Renovation {
  id            String           @id @default(uuid())
  propertyId    String           @map("property_id")
  description   String
  supplier      String?
  plannedAmount Decimal?         @map("planned_amount") @db.Decimal(14,2)
  contractedAmount Decimal?      @map("contracted_amount") @db.Decimal(14,2)
  actualAmount  Decimal?         @map("actual_amount") @db.Decimal(14,2)
  startDate     DateTime?        @map("start_date")
  endDate       DateTime?        @map("end_date")
  status        RenovationStatus @default(PLANEJADA)
  property      Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  expenses      Expense[]
  @@map("renovations")
}

model Sale {
  id          String   @id @default(uuid())
  propertyId  String   @unique @map("property_id")
  buyer       String
  saleAmount  Decimal  @map("sale_amount") @db.Decimal(14,2)
  saleDate    DateTime @map("sale_date")
  brokerage   Decimal  @default(0) @db.Decimal(14,2)
  taxes       Decimal  @default(0) @db.Decimal(14,2)
  notes       String?
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  @@map("sales")
}

model Acquisition {
  id                    String                    @id @default(uuid())
  propertyId            String                    @unique @map("property_id")
  purchasePrice         Decimal?                   @map("purchase_price") @db.Decimal(14,2)
  auctioneerCommission  Decimal?                   @map("auctioneer_commission") @db.Decimal(14,2)
  ownResourcesAmount    Decimal?                   @map("own_resources_amount") @db.Decimal(14,2)
  fgtsAmount            Decimal?                   @map("fgts_amount") @db.Decimal(14,2)
  financingAmount       Decimal?                   @map("financing_amount") @db.Decimal(14,2)
  otherResourcesAmount  Decimal?                   @map("other_resources_amount") @db.Decimal(14,2)
  purchaseDate          DateTime?                  @map("purchase_date")
  acquisitionDate       DateTime?                  @map("acquisition_date")
  paymentDate           DateTime?                  @map("payment_date")
  paymentMethod         AcquisitionPaymentMethod?  @map("payment_method")
  status                AcquisitionStatus          @default(PLANNED)
  source                AcquisitionSource          @default(AUCTION)
  notes                 String?
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")
  property              Property                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([status, purchaseDate])
  @@map("acquisitions")
}

model PropertyDocument {
  id         String                 @id @default(uuid())
  propertyId String                 @map("property_id")
  type       PropertyDocumentType
  status     PropertyDocumentStatus @default(PENDING)
  title      String
  fileName   String?                @map("file_name")
  filePath   String?                @map("file_path")
  mimeType   String?                @map("mime_type")
  fileSize   Int?                   @map("file_size")
  documentDate DateTime?            @map("document_date")
  issuedAt   DateTime?              @map("issued_at")
  expiresAt  DateTime?              @map("expires_at")
  notes      String?
  uploadedAt DateTime               @default(now()) @map("uploaded_at")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  property   Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, type, status])
  @@index([expiresAt])
  @@map("property_documents")
}

model PropertyRegularization {
  id          String               @id @default(uuid())
  propertyId  String               @unique @map("property_id")
  status      RegularizationStatus @default(NOT_STARTED)
  startedAt   DateTime?            @map("started_at")
  completedAt DateTime?            @map("completed_at")
  notes       String?
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  property    Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tasks       RegularizationTask[]

  @@index([status])
  @@map("property_regularizations")
}

model RegularizationTask {
  id               String                    @id @default(uuid())
  regularizationId String                    @map("regularization_id")
  category         RegularizationTaskCategory @default(OUTROS)
  title            String
  description      String?
  status           RegularizationTaskStatus  @default(PENDING)
  dueDate          DateTime?                 @map("due_date")
  completedAt      DateTime?                 @map("completed_at")
  responsible      String?
  cost             Decimal?                  @db.Decimal(14,2)
  notes            String?
  sortOrder        Int                       @default(0) @map("sort_order")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  regularization   PropertyRegularization    @relation(fields: [regularizationId], references: [id], onDelete: Cascade)

  @@index([regularizationId, status, dueDate])
  @@map("regularization_tasks")
}

model PropertyPossession {
  id             String          @id @default(uuid())
  propertyId     String          @unique @map("property_id")
  status         PossessionStatus @default(NOT_TAKEN)
  occupationStatus OccupationStatus? @map("occupation_status")
  possessionDate DateTime?       @map("possession_date")
  keyReceivedDate DateTime?      @map("key_received_date")
  inspectionDate DateTime?       @map("inspection_date")
  occupant       String?
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([status, possessionDate])
  @@map("property_possessions")
}

model PropertyEvent {
  id          String            @id @default(uuid())
  propertyId  String            @map("property_id")
  userId      String?           @map("user_id")
  type        PropertyEventType
  title       String
  description String?
  occurredAt  DateTime          @default(now()) @map("occurred_at")
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at")
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([propertyId, occurredAt])
  @@index([propertyId, type, occurredAt])
  @@index([userId])
  @@map("property_events")
}

model SaleScenario {
  id                 String             @id @default(uuid())
  propertyId         String             @map("property_id")
  name               String
  status             SaleScenarioStatus @default(DRAFT)
  projectedSalePrice Decimal            @map("projected_sale_price") @db.Decimal(14,2)
  brokeragePercent   Decimal?           @map("brokerage_percent") @db.Decimal(7,4)
  projectedBrokerage Decimal            @default(0) @map("projected_brokerage") @db.Decimal(14,2)
  projectedTaxes     Decimal            @default(0) @map("projected_taxes") @db.Decimal(14,2)
  otherSaleCosts     Decimal            @default(0) @map("other_sale_costs") @db.Decimal(14,2)
  netProfit          Decimal?           @map("net_profit") @db.Decimal(14,2)
  roi                Decimal?           @db.Decimal(10,4)
  expectedSaleDate   DateTime?          @map("expected_sale_date")
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  property           Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([propertyId, expectedSaleDate])
  @@map("sale_scenarios")
}
